{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListIcebergPrefix",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketLocation"],
      "Resource": "arn:aws:s3:::my-bucket",
      "Condition": {
        "StringLike": { "s3:prefix": ["snowflake/mock_data/*"] }
      }
    },
    {
      "Sid": "ReadIcebergFiles",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:GetObjectVersion"],
      "Resource": "arn:aws:s3:::my-bucket/snowflake/mock_data/*"
    }
  ]
}
