# Copy to .env (repo root) and fill in. .env is git-ignored.
# Used by the native refresh (.\duck.ps1 refresh) and by the optional Docker image (docker/).

# ---------------------------------------------------------------- where the Iceberg files are
# External volume STORAGE_BASE_URL + the parent folder of BASE_LOCATION from the DDL.
# create-snowflake-iceberg-tables.sql uses BASE_LOCATION = 'mock_data/<table>/', so:
#   STORAGE_BASE_URL = s3://my-bucket/snowflake/   ->   ICEBERG_S3_ROOT=s3://my-bucket/snowflake/mock_data
# Find the exact paths with snowflake/02-find-s3-locations.sql.
ICEBERG_S3_ROOT=s3://my-bucket/snowflake/mock_data

# Tables = sub-folders under ICEBERG_S3_ROOT (lower case, as in the DDL).
ICEBERG_TABLES=products,customers,orders

# Override a single table's folder, or pin an exact metadata file, e.g.
# ICEBERG_PATH_ORDERS=s3://my-bucket/snowflake/mock_data/orders/metadata/00007-1f2e....metadata.json

# Snowflake writes no version-hint.text; DuckDB picks the lexicographically newest
# metadata/0000N-<uuid>.metadata.json. Set false only if you pin ICEBERG_PATH_* files.
ICEBERG_VERSION_GUESSING=true
# Set true if the table folder was copied/moved and metadata still points at the old prefix.
ICEBERG_ALLOW_MOVED_PATHS=false

# ---------------------------------------------------------------- AWS access (read-only)
# Option 1 (default): credential chain. Leave the keys empty and set AWS_PROFILE to a profile
# from %USERPROFILE%\.aws\config (SSO profiles work: run `aws sso login --profile <name>` first).
AWS_PROFILE=
AWS_REGION=eu-west-1
# Docker only: folder with your AWS config/credentials, mounted read-only into the container.
# Windows example: AWS_DIR=C:/Users/kalle/.aws   (forward slashes). Ignored by the native setup.
AWS_DIR=~/.aws

# Option 2: static keys for a read-only IAM user (see aws/iam-read-policy.json).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# S3-compatible stores only (MinIO, Cloudflare R2, ...). Leave empty for AWS S3.
S3_ENDPOINT=
S3_URL_STYLE=
S3_USE_SSL=true

# ---------------------------------------------------------------- refresh
# How often the "loop" mode re-syncs into data/warehouse.duckdb. 0 = run once and exit.
REFRESH_INTERVAL_SECONDS=900
